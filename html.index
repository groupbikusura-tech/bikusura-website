<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Bikusura Group | Building Wealth. Creating Legacy.</title>

<meta name="description" content="Bikusura Group is a diversified family-controlled investment and business group focused on long-term wealth creation, global opportunities, private businesses, education and disciplined capital allocation.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,Arial,sans-serif;
    background:#020914;
    color:#f5f7fa;
    line-height:1.65;
    overflow-x:hidden;
}

:root{
    --bg:#020914;
    --bg2:#071525;
    --bg3:#0a192a;
    --gold:#d8b66c;
    --gold2:#f3d58d;
    --white:#f5f7fa;
    --muted:#99a9bb;
    --muted2:#718094;
    --border:rgba(216,182,108,.22);
    --border2:rgba(255,255,255,.08);
}

/* ================= GLOBAL ================= */

::selection{
    background:var(--gold);
    color:#020914;
}

::-webkit-scrollbar{
    width:7px;
}

::-webkit-scrollbar-track{
    background:#020914;
}

::-webkit-scrollbar-thumb{
    background:#6f5a2f;
    border-radius:10px;
}

a{
    color:inherit;
}

section{
    padding:110px 7%;
    position:relative;
}

.container{
    max-width:1250px;
    margin:auto;
}

.label{
    color:var(--gold2);
    font-size:10px;
    letter-spacing:3px;
    text-transform:uppercase;
    font-weight:700;
    margin-bottom:15px;
}

.title{
    font-size:clamp(36px,4vw,58px);
    line-height:1.08;
    letter-spacing:-2px;
    margin-bottom:20px;
}

.text{
    max-width:780px;
    color:var(--muted);
    font-size:15px;
}

.gold{
    color:var(--gold2);
}

/* ================= NAVBAR ================= */

nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:999;
    padding:15px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(2,9,20,.86);
    backdrop-filter:blur(22px);
    border-bottom:1px solid rgba(255,255,255,.055);
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
    text-decoration:none;
}

.logo{
    width:45px;
    height:45px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.logo svg{
    width:45px;
    height:45px;
    display:block;
}

.brand-text strong{
    display:block;
    color:var(--gold2);
    letter-spacing:2px;
    font-size:15px;
}

.brand-text small{
    display:block;
    color:#657589;
    font-size:7px;
    letter-spacing:2px;
    margin-top:2px;
}

.nav-links{
    display:flex;
    gap:25px;
    list-style:none;
    align-items:center;
}

.nav-links a{
    text-decoration:none;
    color:#dce3ea;
    font-size:11px;
    transition:.3s;
}

.nav-links a:hover{
    color:var(--gold2);
}

.nav-contact{
    border:1px solid var(--border);
    padding:9px 17px;
    border-radius:30px;
    color:var(--gold2)!important;
}

/* ================= HERO ================= */

.hero{
    min-height:100vh;
    padding:170px 7% 110px;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        radial-gradient(circle at 78% 30%,rgba(216,182,108,.17),transparent 23%),
        radial-gradient(circle at 15% 80%,rgba(27,83,135,.16),transparent 30%),
        linear-gradient(135deg,#020914,#071525 55%,#020914);
}

.hero::before{
    content:"";
    position:absolute;
    width:600px;
    height:600px;
    border:1px solid rgba(216,182,108,.075);
    border-radius:50%;
    right:-230px;
    top:100px;
    box-shadow:
        0 0 0 70px rgba(216,182,108,.015),
        0 0 0 140px rgba(216,182,108,.01);
}

.hero::after{
    content:"";
    position:absolute;
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--gold2);
    right:22%;
    top:28%;
    box-shadow:
        0 0 30px var(--gold),
        0 0 70px rgba(216,182,108,.4);
}

.hero-content{
    max-width:1000px;
    position:relative;
    z-index:2;
}

.hero-eyebrow{
    display:flex;
    align-items:center;
    gap:12px;
    color:var(--gold2);
    font-size:10px;
    letter-spacing:3px;
    text-transform:uppercase;
    margin-bottom:27px;
}

.hero-eyebrow::before{
    content:"";
    width:38px;
    height:1px;
    background:var(--gold);
}

.hero h1{
    font-size:clamp(52px,7.5vw,105px);
    line-height:.98;
    letter-spacing:-6px;
    max-width:1050px;
    margin-bottom:30px;
}

.hero h1 span{
    color:var(--gold2);
}

.hero-description{
    max-width:760px;
    color:#aab7c5;
    font-size:17px;
    line-height:1.8;
    margin-bottom:38px;
}

.buttons{
    display:flex;
    flex-wrap:wrap;
    gap:13px;
}

.btn{
    text-decoration:none;
    padding:14px 24px;
    border-radius:8px;
    font-size:12px;
    font-weight:800;
    transition:.3s;
    display:inline-flex;
    align-items:center;
    gap:8px;
}

.primary{
    background:linear-gradient(135deg,#c6a052,#f3d58d);
    color:#07101d;
}

.primary:hover{
    transform:translateY(-3px);
    box-shadow:0 15px 40px rgba(216,182,108,.22);
}

.secondary{
    border:1px solid rgba(255,255,255,.15);
    color:#fff;
}

.secondary:hover{
    border-color:var(--gold);
    color:var(--gold2);
    transform:translateY(-3px);
}

.hero-bottom{
    margin-top:75px;
    display:flex;
    flex-wrap:wrap;
    gap:45px;
}

.hero-stat strong{
    display:block;
    color:var(--gold2);
    font-size:20px;
}

.hero-stat span{
    color:#6f7e91;
    font-size:9px;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

/* ================= STATS ================= */

.stats{
    padding-top:35px;
    padding-bottom:80px;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.stat{
    position:relative;
    overflow:hidden;
    padding:32px 20px;
    border:1px solid var(--border2);
    border-radius:18px;
    text-align:center;
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
}

.stat::after{
    content:"";
    position:absolute;
    width:90px;
    height:90px;
    border-radius:50%;
    right:-45px;
    bottom:-45px;
    border:1px solid rgba(216,182,108,.08);
}

.stat h3{
    color:var(--gold2);
    font-size:28px;
    margin-bottom:4px;
}

.stat p{
    color:var(--muted);
    font-size:11px;
}

/* ================= ABOUT ================= */

.about{
    background:
        linear-gradient(180deg,#020914,#06111f);
}

.about-layout{
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:70px;
    align-items:center;
}

.about-copy{
    max-width:700px;
}

.about-copy .text{
    font-size:15px;
    line-height:1.9;
}

.feature-list{
    margin-top:38px;
    display:grid;
    gap:22px;
}

.feature{
    display:flex;
    gap:16px;
}

.feature-icon{
    min-width:35px;
    height:35px;
    border:1px solid var(--border);
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--gold2);
}

.feature h4{
    font-size:14px;
    margin-bottom:4px;
}

.feature p{
    color:var(--muted);
    font-size:12px;
}

.about-panel{
    min-height:480px;
    border:1px solid var(--border);
    border-radius:28px;
    padding:42px;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 85% 15%,rgba(216,182,108,.16),transparent 28%),
        linear-gradient(145deg,#0b1c2f,#040d18);
}

.about-panel::before{
    content:"";
    position:absolute;
    width:370px;
    height:370px;
    border:1px solid rgba(216,182,108,.11);
    border-radius:50%;
    right:-170px;
    bottom:-170px;
}

.panel-label{
    color:var(--gold2);
    font-size:10px;
    letter-spacing:3px;
    text-transform:uppercase;
}

.panel-heading{
    font-size:45px;
    line-height:1.08;
    font-weight:900;
    margin-top:30px;
}

.panel-heading span{
    color:var(--gold2);
}

.panel-line{
    height:1px;
    background:rgba(216,182,108,.18);
    margin:30px 0;
}

.panel-points{
    display:grid;
    gap:17px;
}

.panel-point{
    display:flex;
    gap:13px;
    color:#aebac7;
    font-size:12px;
}

.panel-point b{
    color:var(--gold2);
}

/* ================= SECTION HEADER ================= */

.section-header{
    max-width:820px;
}

.center-header{
    margin:auto;
    text-align:center;
}

.center-header .text{
    margin:auto;
}

/* ================= VERTICALS ================= */

.verticals{
    background:#050f1c;
}

.vertical-grid{
    margin-top:50px;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.vertical{
    min-height:315px;
    position:relative;
    padding:30px 25px;
    border:1px solid var(--border2);
    border-radius:21px;
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
    overflow:hidden;
    transition:.35s;
}

.vertical:hover{
    transform:translateY(-9px);
    border-color:var(--border);
    box-shadow:0 22px 50px rgba(0,0,0,.28);
}

.vertical::after{
    content:"";
    position:absolute;
    width:150px;
    height:150px;
    border-radius:50%;
    right:-75px;
    bottom:-75px;
    background:rgba(216,182,108,.055);
}

.vertical-number{
    color:#6f7e91;
    font-size:9px;
    letter-spacing:2px;
    margin-bottom:24px;
}

.vertical-icon{
    font-size:34px;
    margin-bottom:20px;
}

.vertical h3{
    font-size:18px;
    margin-bottom:12px;
}

.vertical p{
    color:var(--muted);
    font-size:12px;
    line-height:1.75;
}

.vertical-tag{
    position:absolute;
    bottom:22px;
    left:25px;
    color:#68788c;
    font-size:8px;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

/* ================= FEATURED BUSINESS ================= */

.featured{
    background:
        radial-gradient(circle at 15% 20%,rgba(216,182,108,.08),transparent 27%),
        #020914;
}

.featured-grid{
    margin-top:50px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:22px;
}

.featured-card{
    padding:42px;
    min-height:365px;
    border-radius:25px;
    border:1px solid var(--border);
    position:relative;
    overflow:hidden;
    background:
        linear-gradient(145deg,rgba(216,182,108,.065),rgba(255,255,255,.012));
    transition:.35s;
}

.featured-card:hover{
    transform:translateY(-8px);
    box-shadow:0 25px 55px rgba(0,0,0,.3);
}

.featured-card::after{
    content:"";
    position:absolute;
    width:260px;
    height:260px;
    border-radius:50%;
    right:-125px;
    bottom:-125px;
    border:1px solid rgba(216,182,108,.11);
}

.featured-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.featured-icon{
    font-size:42px;
}

.featured-number{
    color:var(--gold2);
    font-size:9px;
    letter-spacing:2px;
}

.featured-card h3{
    font-size:27px;
    margin-bottom:14px;
}

.featured-card p{
    color:var(--muted);
    font-size:13px;
    line-height:1.8;
    max-width:600px;
}

.pills{
    margin-top:25px;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
}

.pills span{
    padding:7px 11px;
    border-radius:20px;
    border:1px solid rgba(216,182,108,.19);
    color:#bdc7d1;
    font-size:9px;
}

/* ================= PRIVATE BUSINESS ================= */

.private-business{
    background:
        linear-gradient(180deg,#071321,#020914);
}

.private-layout{
    display:grid;
    grid-template-columns:.85fr 1.15fr;
    gap:65px;
    align-items:center;
}

.private-box{
    min-height:450px;
    border:1px solid var(--border);
    border-radius:28px;
    padding:40px;
    background:
        radial-gradient(circle at 20% 20%,rgba(216,182,108,.14),transparent 30%),
        linear-gradient(145deg,#0a1a2b,#030b15);
    position:relative;
    overflow:hidden;
}

.private-box::before{
    content:"PRIVATE";
    position:absolute;
    font-size:100px;
    font-weight:900;
    color:rgba(216,182,108,.025);
    transform:rotate(-15deg);
    right:-20px;
    bottom:40px;
}

.private-box h3{
    font-size:30px;
    margin-top:25px;
}

.private-box p{
    color:var(--muted);
    font-size:13px;
    margin-top:15px;
}

.private-list{
    margin-top:28px;
    display:grid;
    gap:13px;
}

.private-list div{
    color:#b9c4cf;
    font-size:12px;
}

.private-list span{
    color:var(--gold2);
    margin-right:8px;
}

.private-copy .text{
    line-height:1.9;
}

.private-points{
    margin-top:32px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.private-point{
    padding:20px;
    border:1px solid var(--border2);
    border-radius:15px;
    background:rgba(255,255,255,.025);
}

.private-point strong{
    color:var(--gold2);
    display:block;
    margin-bottom:5px;
    font-size:12px;
}

.private-point p{
    color:var(--muted);
    font-size:11px;
}

/* ================= EDUCARE ================= */

.educare{
    background:
        radial-gradient(circle at 85% 15%,rgba(216,182,108,.11),transparent 28%),
        #050f1c;
}

.educare-layout{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:55px;
    align-items:center;
}

.educare-copy .text{
    line-height:1.9;
}

.educare-badge{
    display:inline-block;
    margin:20px 0 25px;
    padding:9px 15px;
    border-radius:30px;
    border:1px solid var(--border);
    color:var(--gold2);
    font-size:10px;
    letter-spacing:2px;
}

.educare-topics{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
    margin-top:30px;
}

.topic{
    padding:16px;
    border:1px solid var(--border2);
    border-radius:14px;
    background:rgba(255,255,255,.025);
}

.topic strong{
    display:block;
    font-size:12px;
    margin-bottom:4px;
}

.topic span{
    color:var(--muted);
    font-size:10px;
}

.educare-card{
    min-height:440px;
    padding:42px;
    border:1px solid var(--border);
    border-radius:28px;
    background:
        radial-gradient(circle at 50% 15%,rgba(216,182,108,.16),transparent 28%),
        linear-gradient(145deg,#0b1c2e,#040c17);
    text-align:center;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    position:relative;
    overflow:hidden;
}

.educare-card::before{
    content:"";
    position:absolute;
    width:300px;
    height:300px;
    border:1px solid rgba(216,182,108,.12);
    border-radius:50%;
}

.educare-symbol{
    width:90px;
    height:90px;
    border-radius:50%;
    border:1px solid var(--gold);
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:40px;
    margin-bottom:25px;
    box-shadow:0 0 45px rgba(216,182,108,.08);
    position:relative;
}

.educare-card h3{
    font-size:29px;
    position:relative;
}

.educare-card .tagline{
    color:var(--gold2);
    letter-spacing:2px;
    font-size:10px;
    margin-top:8px;
    position:relative;
}

.educare-card p{
    color:var(--muted);
    font-size:12px;
    max-width:400px;
    margin-top:20px;
    position:relative;
}

/* ================= GLOBAL ================= */

.global{
    background:
        radial-gradient(circle at 15% 25%,rgba(216,182,108,.09),transparent 25%),
        #071321;
}

.market-grid{
    margin-top:50px;
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:15px;
}

.market{
    padding:28px 10px;
    text-align:center;
    border:1px solid var(--border2);
    border-radius:17px;
    background:rgba(255,255,255,.025);
    transition:.3s;
}

.market:hover{
    transform:translateY(-6px);
    border-color:var(--gold);
}

.flag{
    font-size:31px;
    margin-bottom:10px;
}

.market strong{
    display:block;
    font-size:13px;
}

.market small{
    color:var(--muted);
    font-size:9px;
}

.global-note{
    margin-top:42px;
    padding:25px;
    border-left:2px solid var(--gold);
    background:rgba(255,255,255,.025);
    color:var(--muted);
    font-size:12px;
}

/* ================= APPROACH ================= */

.approach{
    background:#020914;
}

.approach-grid{
    margin-top:50px;
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:13px;
}

.approach-card{
    padding:30px 20px;
    min-height:220px;
    border:1px solid var(--border2);
    border-radius:18px;
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.01));
}

.approach-number{
    color:var(--gold2);
    font-size:10px;
    letter-spacing:2px;
}

.approach-card h3{
    margin:17px 0 10px;
    font-size:17px;
}

.approach-card p{
    color:var(--muted);
    font-size:11px;
}

/* ================= FOUNDER ================= */

.founder{
    background:
        linear-gradient(180deg,#020914,#06111f);
}

.founder-layout{
    display:grid;
    grid-template-columns:330px 1fr;
    gap:65px;
    align-items:center;
}

.founder-card{
    min-height:420px;
    border-radius:27px;
    border:1px solid var(--border);
    background:
        radial-gradient(circle at 50% 18%,rgba(216,182,108,.17),transparent 30%),
        linear-gradient(145deg,#0b1c2e,#040c17);
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:30px;
}

.founder-initial{
    width:115px;
    height:115px;
    border-radius:50%;
    border:1px solid var(--gold);
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--gold2);
    font-size:49px;
    font-weight:900;
    margin-bottom:25px;
    box-shadow:0 0 45px rgba(216,182,108,.09);
}

.founder-card h3{
    font-size:22px;
}

.founder-card p{
    color:var(--gold2);
    font-size:11px;
    margin-top:5px;
}

.founder-name{
    font-size:45px;
    letter-spacing:-2px;
    margin-bottom:3px;
}

.role{
    color:var(--gold2);
    font-size:13px;
    margin-bottom:25px;
}

.founder-text{
    color:var(--muted);
    font-size:14px;
    line-height:1.9;
    margin-bottom:15px;
}

.signature{
    margin-top:25px;
    color:#657589;
    font-family:"Playfair Display",serif;
    font-size:21px;
}

/* ================= INSIGHTS ================= */

.insights{
    background:#050f1c;
}

.insight-grid{
    margin-top:50px;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.insight{
    min-height:285px;
    padding:31px;
    border:1px solid var(--border2);
    border-radius:20px;
    background:linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.01));
    transition:.3s;
}

.insight:hover{
    transform:translateY(-7px);
    border-color:var(--border);
}

.insight-icon{
    width:50px;
    height:50px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(216,182,108,.08);
    color:var(--gold2);
    font-size:21px;
    margin-bottom:23px;
}

.tag{
    color:var(--gold2);
    font-size:8px;
    letter-spacing:2px;
    text-transform:uppercase;
}

.insight h3{
    margin:10px 0;
    font-size:18px;
}

.insight p{
    color:var(--muted);
    font-size:12px;
    line-height:1.75;
}

/* ================= SOCIAL ================= */

.social{
    text-align:center;
    background:
        radial-gradient(circle at center,rgba(216,182,108,.09),transparent 35%),
        #020914;
}

.social .text{
    margin:auto;
}

.social-links{
    margin-top:35px;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:11px;
}

.social-links a{
    padding:13px 20px;
    border:1px solid var(--border);
    border-radius:30px;
    text-decoration:none;
    font-size:11px;
    color:#e4e9ef;
    transition:.3s;
}

.social-links a:hover{
    transform:translateY(-3px);
    color:var(--gold2);
    background:rgba(216,182,108,.04);
}

/* ================= CONTACT ================= */

.contact{
    background:#050f1c;
}

.contact-box{
    max-width:1000px;
    margin:auto;
    padding:75px 40px;
    text-align:center;
    border:1px solid var(--border);
    border-radius:30px;
    background:
        radial-gradient(circle at 50% 0%,rgba(216,182,108,.14),transparent 42%),
        linear-gradient(145deg,#0a1a2b,#040c17);
}

.contact-box .text{
    margin:auto;
}

.contact-info{
    margin-top:32px;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
}

.contact-info a{
    text-decoration:none;
    color:var(--gold2);
    border:1px solid rgba(216,182,108,.24);
    padding:12px 20px;
    border-radius:30px;
    font-size:12px;
}

/* ================= FOOTER ================= */

footer{
    padding:60px 7% 27px;
    text-align:center;
    border-top:1px solid rgba(255,255,255,.07);
    background:#020914;
}

.footer-logo{
    color:var(--gold2);
    font-size:23px;
    font-weight:900;
    letter-spacing:4px;
}

.footer-tagline{
    color:#68778a;
    font-size:9px;
    letter-spacing:2px;
    margin-top:7px;
}

.footer-links{
    margin-top:25px;
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:20px;
}

.footer-links a{
    color:#8795a6;
    text-decoration:none;
    font-size:10px;
}

.footer-links a:hover{
    color:var(--gold2);
}

footer p{
    max-width:900px;
    margin:23px auto 0;
    color:#647388;
    font-size:10px;
    line-height:1.7;
}

.copyright{
    margin-top:27px!important;
    color:#49586a!important;
}

/* ================= RESPONSIVE ================= */

@media(max-width:1100px){

    .vertical-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .market-grid{
        grid-template-columns:repeat(3,1fr);
    }

    .stats-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .approach-grid{
        grid-template-columns:repeat(3,1fr);
    }

    .nav-links{
        gap:13px;
    }
}

@media(max-width:850px){

    nav{
        padding:13px 5%;
    }

    .nav-links{
        display:none;
    }

    section{
        padding:80px 5%;
    }

    .hero{
        padding:140px 5% 85px;
    }

    .hero h1{
        letter-spacing:-3px;
    }

    .hero-description{
        font-size:15px;
    }

    .about-layout,
    .private-layout,
    .educare-layout,
    .founder-layout{
        grid-template-columns:1fr;
    }

    .featured-grid{
        grid-template-columns:1fr;
    }

    .educare-layout{
        gap:35px;
    }

    .insight-grid{
        grid-template-columns:1fr;
    }

    .founder-card{
        max-width:450px;
        margin:auto;
    }
}

@media(max-width:600px){

    .stats-grid,
    .vertical-grid,
    .approach-grid{
        grid-template-columns:1fr;
    }

    .market-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .hero h1{
        font-size:48px;
    }

    .hero-bottom{
        gap:25px;
    }

    .about-panel,
    .featured-card,
    .private-box,
    .educare-card{
        padding:28px;
    }

    .panel-heading{
        font-size:36px;
    }

    .private-points,
    .educare-topics{
        grid-template-columns:1fr;
    }

    .founder-name{
        font-size:34px;
    }

    .contact-box{
        padding:55px 22px;
    }

}

</style>
</head>

